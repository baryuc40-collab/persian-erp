# Copy to .env next to docker-compose.yml and change every value marked "change".

# Image to run; IMAGE_TAG is a release such as 2.2.22-fa.1
IMAGE=ghcr.io/baryuc40-collab/persian-erp
IMAGE_TAG=latest
# Port on the server
HTTP_PORT=13000

# change: a long random string (e.g. openssl rand -hex 32); keep it, it signs sessions
APP_KEY=change-me

DB_DATABASE=nocobase
DB_USER=nocobase
# change
DB_PASSWORD=change-me

# First administrator, created on the first start only
INIT_ROOT_EMAIL=admin@example.com
INIT_ROOT_USERNAME=admin
# change
INIT_ROOT_PASSWORD=change-me
INIT_ROOT_NICKNAME="مدیر سیستم"

# Image defaults, shown here so they can be changed
INIT_APP_LANG=fa-IR
TZ=Asia/Tehran

# Process engine Camunda 8 (optional). Uncomment COMPOSE_PROFILES to run it with every `docker compose` command.
# It needs about 2 GB more memory. Its license allows non-production use only, unless CAMUNDA_LICENSE_KEY is set.
#COMPOSE_PROFILES=bpm
# change: the password of the engine's database user (camunda)
CAMUNDA_DB_PASSWORD=change-me
# The service user plugin-bpm signs in to the engine with; change the password
BPM_ENGINE_USERNAME=nocobase
BPM_ENGINE_PASSWORD=change-me
# Days the log of the exchanges with the engine (bpmEvents) is kept
BPM_EVENTS_RETENTION_DAYS=90
# The engine's own administrator, for Operate and Tasklist through an SSH tunnel; change the password
CAMUNDA_ADMIN_USERNAME=admin
CAMUNDA_ADMIN_PASSWORD=change-me
# Finished process instances are removed from the engine's history after this long (P180D: 180 days)
CAMUNDA_HISTORY_TTL=P180D
# Java heap of the engine
CAMUNDA_HEAP=2g
CAMUNDA_LICENSE_KEY=
