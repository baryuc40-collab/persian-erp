# Copy to .env next to docker-compose.yml and change every value marked "change".

# Image to run; IMAGE_TAG is a release such as 2.2.22-fa.1
IMAGE=ghcr.io/baryuc40-collab/persian-erp
IMAGE_TAG=latest
# Port on the server
HTTP_PORT=13000

# change: a long random string (e.g. openssl rand -hex 32); keep it, it signs sessions
APP_KEY=change-me

DB_DATABASE=nocobase
DB_USER=nocobase
# change
DB_PASSWORD=change-me

# First administrator, created on the first start only
INIT_ROOT_EMAIL=admin@example.com
INIT_ROOT_USERNAME=admin
# change
INIT_ROOT_PASSWORD=change-me
INIT_ROOT_NICKNAME="مدیر سیستم"

# Image defaults, shown here so they can be changed
INIT_APP_LANG=fa-IR
TZ=Asia/Tehran
