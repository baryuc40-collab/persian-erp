# کپی کنید: cp .env.example .env
# APP_KEY را با یک رشته‌ی تصادفی جایگزین کنید: openssl rand -base64 64 | tr -d '\n'

APP_ENV=development
APP_KEY=change-me
APP_PORT=13000

API_BASE_PATH=/api/
API_BASE_URL=

PLUGIN_PACKAGE_PREFIX=

# زبان پیش‌فرض برنامه هنگام نصب اول (معادل `yarn nocobase install --lang`). پس از فاز ۱ به fa-IR تغییر می‌کند.
INIT_APP_LANG=en-US
# زبان پیام‌های سمت سرور (لاگ و خطاهای API)، نه زبان رابط کاربری.
INIT_LANG=en-US
# plugin-fa و plugin-modules هنگام نصب فعال می‌شوند و از «مدیریت پلاگین‌ها» غیرفعال نمی‌شوند.
APPEND_PRESET_BUILT_IN_PLUGINS=@persian-erp/plugin-fa,@persian-erp/plugin-modules
TZ=Asia/Tehran

DB_LOGGING=off
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=nocobase
DB_USER=nocobase
DB_PASSWORD=nocobase

INIT_ROOT_EMAIL=admin@nocobase.com
INIT_ROOT_PASSWORD=admin123
INIT_ROOT_NICKNAME=Super Admin
INIT_ROOT_USERNAME=nocobase

# موتور فرایند (اختیاری؛ docker compose --profile bpm up -d). کاربر سرویسی که plugin-bpm با آن به موتور وصل می‌شود.
BPM_ENGINE_USERNAME=nocobase
BPM_ENGINE_PASSWORD=change-me
# مدیر خود موتور Camunda، برای Operate و Tasklist
CAMUNDA_ADMIN_USERNAME=admin
CAMUNDA_ADMIN_PASSWORD=change-me
# رمز کاربر camunda در PostgreSQL، که تاریخچه‌ی موتور در پایگاه داده‌ی camunda است
CAMUNDA_DB_PASSWORD=camunda
# نمونه‌های تمام‌شده پس از این مدت از تاریخچه‌ی موتور پاک می‌شوند (P180D یعنی ۱۸۰ روز)
CAMUNDA_HISTORY_TTL=P180D
CAMUNDA_HEAP=2g
# فقط برای استفاده‌ی واقعی Camunda 8 (تصمیم ۰۰۰۸)
CAMUNDA_LICENSE_KEY=
